# ============================================
# Variaveis de ambiente - Serralheria Ribeiro
# Copie este arquivo para .env.local no desenvolvimento
# ou cadastre as mesmas chaves no painel da Vercel.
# ============================================

# Banco de dados PostgreSQL
# Local: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Producao (Supabase/Neon/Vercel Postgres): use a connection string completa
DATABASE_URL=postgresql://user:password@host:5432/serralheria

# Ative SSL para hosts gerenciados (Supabase/Neon). Local normalmente false.
DB_SSL=false

# Senha do painel admin (obrigatoria em producao)
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Ambiente
NODE_ENV=development

# Supabase Storage (upload de imagens do portfolio)
# Crie um bucket publico chamado "portfolio" ou ajuste o nome abaixo.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_STORAGE_BUCKET=portfolio
